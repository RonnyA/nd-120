  <main name="SMD3044_MA_WC"/>
  <circuit name="SMD3044_MA_WC">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="SMD3044_MA_WC"/>
    <comp lib="4" loc="(2600,40)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="ND-632 15 MHz SMD controller, card 3044, logic diagram sheet 3, block 'MEMORY ADDRESS &amp; WORD COUNT'"/></comp>
    <comp lib="4" loc="(2600,58)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="(ND-11.020.01, scan page 118). Chip position codes, DIP pin numbers and signal names are the drawing's."/></comp>
    <comp lib="4" loc="(2600,76)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="Gate types the manual does not state (it has no parts list), chosen by what the circuit must do - check them:"/></comp>
    <comp lib="4" loc="(2600,94)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="  3E, 1G, 4C = AND; 4B = NAND; 1C, 14F = inverter. 3E and 1C/3A are drawn with the SAME symbol, yet 3E must"/></comp>
    <comp lib="4" loc="(2600,112)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="  be an AND (a NAND would hold 4E preset) and 3A must invert (RREG1 must be the opposite of RREG0)."/></comp>
    <comp lib="4" loc="(2600,130)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="  R40, R39 and RN9 pin 8 on DB16-18: the far end is not drawn; shown as pull-downs like the rest of RN9."/></comp>
    <comp lib="4" loc="(2600,148)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="  C13 (220 pF on the 4E preset) is not drawn. 14C /ACI and /WCI (pins 3, 1) use the same rail symbol as"/></comp>
    <comp lib="4" loc="(2600,166)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="  /IE (pin 8), which must be ground for any instruction to run - so they are ground."/></comp>
    <comp lib="4" loc="(2600,184)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="Am2942: subcircuit built from the AMD data sheet (03574B) function table; D0-D7 inputs on the DIP pins,"/></comp>
    <comp lib="4" loc="(2600,202)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="the three-state outputs Y0-Y7 beside the body are tied to the same nets (Logisim cannot make a two-way port)."/></comp>
    <comp lib="4" loc="(2600,220)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="Not on this sheet, drawn as stand-ins: the NOT gates making X1 from the LS138 X0 strobes (sheet 1, 3A),"/></comp>
    <comp lib="4" loc="(2600,238)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="and two 74244s putting the ND-100 A register on DB0-15 (the sheet 1 bus transceivers)."/></comp>
    <comp lib="4" loc="(2600,256)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="SCOPE: the controller's own microcode ROM (which runs disc transfers) is not available, so the controller"/></comp>
    <comp lib="4" loc="(2600,274)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="as a whole cannot be simulated. This block's register loads come straight from the CPU's IOX strobes and"/></comp>
    <comp lib="4" loc="(2600,292)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="do not pass through that ROM; transfer-time signals from it (DWC0, ADREN1, INGRANT0, RFT1) are inputs here."/></comp>
    <comp lib="4" loc="(2600,310)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="OPEN: DWC0 must rest LOW between transfers for any IOX load to clock the 2942s - 2C/2D pins 1 and 2 are both"/></comp>
    <comp lib="4" loc="(2600,328)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="DWC0, so DWC0 HIGH holds the LS54 output LOW. The 0 subscript would say active-low; DWC0 is made off this"/></comp>
    <comp lib="4" loc="(2600,346)" name="Text"><a name="font" val="SansSerif plain 11"/><a name="text" val="sheet and has not been traced."/></comp>
