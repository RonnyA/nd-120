# --------------------------------------------------------------------------
# Where $readmemh looks for the terminal font (28-AUG-2026).
#
# UNVERIFIED, and deliberately belt-and-braces. Vivado resolves $readmemh
# relative to the .v that contains it; Quartus is believed to resolve relative
# to the PROJECT directory, but that has not been confirmed on this toolchain,
# and getting it wrong gives an empty font ROM - a screen full of blank boxes,
# which looks like a video bug rather than a missing file.
#
# So both are covered: this search path, AND `make font` copies the hex into
# the project directory before building. Whichever rule Quartus actually uses,
# it finds the file. If the glyphs ever come out blank, look here first.
# --------------------------------------------------------------------------
set_global_assignment -name SEARCH_PATH ../../Terminals/font
# Same belt-and-braces for the microcode PROM (CPU_CS_PROM_19.v's $readmemh),
# build 2, 31-AUG-2026 - see the note in Makefile's "microcode" target.
set_global_assignment -name SEARCH_PATH "../../CPU-BOARD-3202/circuit"
# nd120_backwiring_defaults.vh: `include`d by ND120_CORE.v and BACKWIRING_PROM.v
# (build 2, 31-AUG-2026). Quartus errored "can't open Verilog Design File"
# without this - unlike a VERILOG_FILE module, an `include needs its own
# directory on the search path, the SEARCH_PATH additions above do not cover it.
set_global_assignment -name SEARCH_PATH ../../Shared/support
# ND_FLOPPY_DMA.v and ND_WINCHESTER.v both open with
# `include "nd_storage_status.vh", which lives with the SD-FAT sources rather
# than beside them (01-SEP-2026, when the ND-bus devices were switched on).
set_global_assignment -name SEARCH_PATH ../../SD-FAT/circuit

