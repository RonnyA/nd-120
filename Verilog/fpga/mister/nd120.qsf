set_global_assignment -name VERILOG_FILE ../../Shared/ndlib/F924_EN.v
set_global_assignment -name VERILOG_FILE ../../Shared/ndlib/SCAN_WITH_SET_N.v
set_global_assignment -name VERILOG_FILE ../../Shared/ndlib/SR44.v
