set_global_assignment -name VERILOG_FILE ../../Shared/support/AM29841.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/AM29861A.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/AM29C821.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/Am9150.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/FIFO_8BIT.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/IDT6168A_20.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/IMS1403_25.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/SC2661_UART.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/SIP1M9.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TMM2018D_25.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74139.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74244.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74245.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74273.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74374.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74393.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74534.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74646.v
set_global_assignment -name VERILOG_FILE ../../Shared/support/TTL_74648.v
set_global_assignment -name VERILOG_FILE ../../ND120_CORE.v
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# --- ND-120 core defines ------------------------------------------------
# FPGA_FF_MODE: edge-triggered flip-flops instead of the original transparent
# latches. Cyclone V has the same constraints as the Artix-7 (no transparent
# latches, no internal tri-states, no gated clocks), so every FPGA build needs
# this. VERILATOR_SIM must NOT be defined here - that one switches in the 6 MB
# sim RAM and the fast UART.
set_global_assignment -name VERILOG_MACRO "FPGA_FF_MODE=1"
# BOARD_CLK_FREQ / UART_BAUD_RATE: the console SC2661's baud generator divides
# the REAL clk_cpu rate by these - they must match what nd120.sv actually
# wires to CORE.clk_cpu (clk_sys, 40 MHz) or the console garbles. Build 2,
# 31-AUG-2026 - see the note above the ND120_CORE instance in nd120.sv.
# 20 MHz = clk_sys/2, the CPU clock. MUST match nd120.sv's clk_cpu divider:
# SC2661_UART.v turns BOARD_CLK_FREQ/UART_BAUD_RATE into the console baud
# divisor at COMPILE time, so a mismatch here garbles the console. The CPU
# ran at 40 MHz until 31-AUG-2026, above this netlist's measured Fmax of
# 36.91 MHz - see the long note by the divider in nd120.sv.
set_global_assignment -name VERILOG_MACRO "BOARD_CLK_FREQ=20000000"
set_global_assignment -name VERILOG_MACRO "UART_BAUD_RATE=115200"
# ND120_UART_DELAY_FRAMES: the console UART's clocks-per-bit, stated OUTRIGHT
# instead of left to `BOARD_CLK_FREQ / `UART_BAUD_RATE arithmetic inside
# SC2661_UART.v. 20 MHz / 115200 = 173.
#
# Why say it explicitly (31-AUG-2026): if BOARD_CLK_FREQ does not reach that
# file for any reason, its own `ifndef falls back to 100 MHz and the chip
# transmits at 20e6/868 = 23 kbaud into a receiver expecting 115200 - which
# looks exactly like the "console shows nothing" this board had, with the CPU
# otherwise healthy (self-test passed, CPU GREEN lamp lit). This override
# removes that entire class of doubt, and it is the same knob the sim uses to
# get real-timing UART pacing. Note the simulator NEVER exercises this path:
# under VERILATOR_SIM the divisor is hardcoded to 16, a fast sim UART, so no
# amount of simulation can catch a real-baud mismatch.
# 5 MHz / 115200 = 43.4 -> 43 (was 173 for 20 MHz). The on-screen diagnostics
# do not depend on this - the diag printer feeds the console byte stream
# directly, not through the CPU UART - but keep it consistent.
set_global_assignment -name VERILOG_MACRO "ND120_UART_DELAY_FRAMES=173"
# MAIN_RAM_BLOCKRAM: MEM_43.v requires an explicit main-memory backend choice
# (a missing one is a deliberate elaboration error, not a silent default).
# Cyclone V has plenty of on-chip block RAM for the small BRAM config
# (MEM_RAM_49_BLOCKRAM), same choice as Basys3/Cmod A7/QMTech.
set_global_assignment -name VERILOG_MACRO "MAIN_RAM_BLOCKRAM=1"
# ND120_BLOCKRAM_ADDR_BITS: words per bank = 2**this. The RTL default is 12
# (4K words/bank = 24 KB total), sized for the Basys3 xc7a35t's tiny BRAM -
# and NO configuration that has ever booted runs that small (Nexys uses 16,
# Tang has 8 MB SDRAM, runSim 6 MB). The microcode self-test includes a
# MEMORY REFERENCE test and halts into STERR if it fails, which never
# reaches MACL2 and so never gives an OPCOM prompt (boot-sequence.md 8/11) -
# exactly the symptom this board had on 31-AUG-2026.
# 15 = 32K words/bank = 192 KB. Nexys's 16 does NOT fit here: 262144 words
# needs ~512 M10K blocks against this device's 553, plus ~147 already used
# by the WCS/terminal/framework. 15 needs ~256, landing near 73%.
set_global_assignment -name VERILOG_MACRO "ND120_BLOCKRAM_ADDR_BITS=15"
# --- Quartus RAM handling. Pick exactly ONE of the two macros below. -------
#
# Quartus 17.0.2 will not infer M10K from the plain-Verilog arrays in
# IDT6168A_20.v (WCS, 32 instances) and MEM_RAM_49_BLOCKRAM.v that Vivado,
# Gowin and Verilator all accept. It reports every one of them as
#   Info (276007): ... uninferred due to asynchronous read logic
# and then fails outright trying to build them from flip-flops:
#   Error (276003): Cannot convert all sets of registers into RAM megafunctions
#
# MEASURED 01-SEP-2026 (build v46): adding Quartus's own "ramstyle" spelling
# to those arrays does NOT fix this. The attribute spelling was never the
# reason - the shape of the output register is. So one of these two is needed.
#
# QUARTUS_RAM_INFER: plain-Verilog arrays restructured so Quartus can infer
# them - the array read gets a register of its own and the bypass/hold logic
# moves outside it. It is ordinary Verilog, so iverilog runs the real code
# and Shared/support/sim/run_quartus_ram_equiv.sh proves it cycle-identical
# to the reference arm (test-quartus-ram-equiv). Demonstrated to FAIL that
# gate when given an extra clock of read latency. Proven on the board in
# build v47 (01-SEP-2026): boots to the OPCOM prompt.
#
# Its predecessor, an explicit altsyncram megafunction arm
# (QUARTUS_ALTSYNCRAM), was deleted 01-SEP-2026. NOTHING simulates a
# megafunction - the equivalence gate could only compare it against a
# hand-written stub, which is exactly how outdata_reg_a="CLOCK0" shipped a
# 2-clock WCS read and stopped the CPU booting for a day. There is no
# fallback macro any more; if inference ever breaks, fix the inference arm.
set_global_assignment -name VERILOG_MACRO "QUARTUS_RAM_INFER=1"
# ND120_PANEL_CLOCK: ON by default on every other FPGA build (Tang, Nexys).
# Missing here meant PANEL_ACTLV was a hardcoded stub constant (16'd0) - not
# just a display gap: the project's own history (panel-clock-68705.md) notes
# the CPU's panel-command microcode traffic (TRA PANS/TRR PANC) reaches the
# DGA unconditionally now, and a stub that never acknowledges those commands
# is a real candidate for a boot hang, not only a missing readout.
set_global_assignment -name VERILOG_MACRO "ND120_PANEL_CLOCK=1"
# ND120_MIPS_TAP: builds CGA_ALU's XGPRLOAD_DBG, which IS DEBUG_CFETCH
# (CGA.v:236) and therefore the only thing feeding the panel's MIPS counter -
# without it that field is hardwired 0 and the panel reads a permanent 00.00.
# It costs fanout on ALUCLK_EN, the fanout-238 net at the end of the
# control-store critical cone, which is why the Nexys gates it; this board has
# room for it (Fmax 28.62 MHz against a 20 MHz clock, 43% margin) and during
# bring-up a live "is the CPU executing anything" number is worth having.
set_global_assignment -name VERILOG_MACRO "ND120_MIPS_TAP=1"
# ND120_NO_CACHE: the Tang's configuration, and a COHERENT cache-off one.
# Measured 31-AUG-2026: with CACHE_SW genuinely 1 this design needs 44,114
# ALMs against the device's 41,910 (105%) - it does not fit, exactly as the
# Tang found (tang20k_defines.v: 28330 cells against 20736). Tying CACHE_SW
# to 0 instead only let Quartus constant-propagate the cache away, leaving a
# halfway state NO booting board runs.
#
# This define is the proper version: it omits the five cache memories and the
# used-bit PAL, forces the SW1 cache-off position, AND makes the machine
# REPORT the cache as disabled - that last part is what CACHE_SW=0 alone did
# not do. The Tang boots SINTRAN this way, with CACHE_SW tied HIGH and this
# define overriding it, which is what nd120.sv now does too.
# CACHE IS IN, matching the Nexys (build.tcl:323 "COMPILED IN BY DEFAULT since
# 29-AUG-2026", nocache is opt-in there). Ronny, 01-SEP-2026: "Mister should
# use the Nexys config. we should use cache, we should use panel clock. we
# should include tape, floppy and wd."
#
# The earlier "it does not fit" measurement (44,114 ALMs against 41,910) was an
# ARTIFACT, not the cache's real cost. The five cache RAMs carried only Vivado's
# `ram_style` attribute; Quartus does not know that spelling, said so
# ("Warning (10335): Unrecognized synthesis attribute ram_style" on Am9150.v
# and TMM2018D_25.v), reported "Found 5 instances of uninferred RAM logic", and
# built them from flip-flops - 4 x 2048 x 8 + 1024 x 4 bits of registers, which
# is the whole overflow. Both spellings are now stated in those two files.
#
# MEASURED 01-SEP-2026: with the cache AND the three ND-bus devices both in,
# the fitter needs 5537 LABs against the device's 4191 - 32% over. It is a real
# device limit, not the old inference artifact: the ramstyle fix worked (the
# "5 instances of uninferred RAM logic" message is gone), but the four cache
# chips must keep an ASYNCHRONOUS read (TMM2018D_25.v: a registered read made
# HIT decide a cycle late and broke CACHE test 2), and async read means LUT/
# MLAB memory, which consumes LABs.
#
# Ronny's call: devices in, cache out. That is also what the Nexys actually
# RUNS - build.tcl compiles the cache in, but the deployed image has the cache
# switch off. Revisit when there is room, or if the cache RAMs get cheaper.
set_global_assignment -name VERILOG_MACRO "ND120_NO_CACHE=1"
# SKIP_WCS_LOAD: microcode preloaded into the WCS from the bitstream, the
# SAME choice Nexys (build.tcl:155, default unless -promload) and Tang
# (tang20k_defines.v:24) both make. Without it this board ran the runtime
# PROM->WCS loader instead - a path NEITHER proven board exercises - and the
# WCS came up empty, so the CPU executed blank microcode and did nothing at
# all (measured on hardware 31-AUG-2026: console + panel fine, CPU dead).
# The 32 wcs_*.hex images are read straight in by $readmemh, as on the other
# boards (the MIF conversion step went with the altsyncram arm, 01-SEP-2026).
set_global_assignment -name VERILOG_MACRO "SKIP_WCS_LOAD=1"
# Quartus's built-in LATCH primitive collides with Shared/ndlib/LATCH.v's
# module name - see the header comment there.
set_global_assignment -name VERILOG_MACRO "QUARTUS_LATCH_RENAME=1"
# ND120_DIAG_PRINT: prints a CPU liveness line on the console once a second
# (rtl/nd120_diag_print.v). DIAGNOSTIC SCAFFOLDING - remove this line once the
# CPU runs. Added 31-AUG-2026 because every build report was clean while the
# CPU showed no sign of life, so the next thing needed was a measurement of
# the CPU itself, readable from a screenshot pulled over ssh.
# DIAG PRINT OFF (01-SEP-2026): the CPU now reaches MACL2 - green lamp lit,
# MIPS 00.43, and 001020 returns to 002027 as it should. Turn the scaffolding
# off so the console shows the machine, not the probe.
# set_global_assignment -name VERILOG_MACRO "ND120_DIAG_PRINT=1"
# TANG_NO_PAN: A/B EXPERIMENT, 01-SEP-2026. Hard-disables the panel request
# (PAN) input to INTRQN inside CGA_INTR.v:132 - the diagnostic that file was
# already written for. Measured on this board: the interrupt debug word reads
# PAN=1 and INTRQ=1 while PICV is EMPTY and no level ever goes active, and the
# microcode loops forever in the interrupt-register routines
# (RIIE1/RPIE1/RPID1/CHKIT/PICFM). CGA_INTR.v's own comment describes exactly
# that shape: "the stale-INTRQN -> macro -> level 10". If disabling PAN makes
# the loop stop, PAN is the trigger. REMOVE once the question is answered -
# this is a measurement, not a fix.
# ANSWERED 01-SEP-2026 and switched back off. With PAN disabled the phantom
# interrupt DID vanish (the debug word went from 000005 to 000000), but the
# microcode loop was completely unchanged and there was still no OPCOM prompt.
# So PAN was a real spurious request AND a red herring: the boot failure is not
# caused by interrupts. Left here, off, so nobody re-runs the same experiment.
# set_global_assignment -name VERILOG_MACRO "TANG_NO_PAN=1"
# ------------------------------------------------------------------------
