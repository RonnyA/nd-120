# Source list for the ND-120 MiSTer core.
#
# Paths are relative to THIS file (Verilog/fpga/mister/). The shared terminal
# core is referenced in place under Verilog/Terminals/ rather than copied here
# - copies drift, and the whole point of that folder is that the Nexys, MiSTer
# and MEGA65 builds compile the SAME files.
#
# BUILD 1 (28-AUG-2026): console only, no ND-120 RTL. The CPU sources join
# this list in build 2.

# --- MiSTer-specific glue ---------------------------------------------------
set_global_assignment -name VERILOG_FILE rtl/nd120_console_mister.v
# The CPU's own 20 MHz PLL - see the header there for why the CPU clock must
# NOT be a fabric divider on this device.
set_global_assignment -name VERILOG_FILE rtl/pll_cpu.v
set_global_assignment -name VERILOG_FILE rtl/nd120_diag_print.v

# --- ND-BUS devices (01-SEP-2026) -------------------------------------------
# Added when INCLUDE_TAPE/FLOPPY/WD were turned on in nd120.sv to match the
# Nexys. ND_BUS_SLAVE comes with them: ND120_CORE instantiates it for ANY
# device (ND120_CORE.v:566), and it is what carries the device interrupt lines
# BINT10..13 and the IDENT chain. SMD is left out - INCLUDE_SMD stays 0, the
# same choice the Nexys makes (it builds the Winchester instead).
set_global_assignment -name VERILOG_FILE ../../ND-BUS-DEVICES/BUS-IF/circuit/ND_BUS_SLAVE.v
set_global_assignment -name VERILOG_FILE ../../ND-BUS-DEVICES/DMA/circuit/ND_DMA_MASTER.v
set_global_assignment -name VERILOG_FILE ../../ND-BUS-DEVICES/TAPE-400/circuit/ND_TAPE_400.v
set_global_assignment -name VERILOG_FILE ../../ND-BUS-DEVICES/FLOPPY-DMA/circuit/ND_FLOPPY_DMA.v
set_global_assignment -name VERILOG_FILE ../../ND-BUS-DEVICES/WINCHESTER/circuit/ND_WINCHESTER.v
set_global_assignment -name VERILOG_FILE rtl/nd120_csa_trace.v
set_global_assignment -name VERILOG_FILE rtl/nd120_sterr_catch.v

# --- main memory: the SDRAM module through the Tang's sheet-49 bridge --------
# (01-SEP-2026) Plain Verilog, no Gowin primitives; the 16-bit-module mode is
# ND_SDRAM_DQ16 in nd120.qsf. MEM_RAM_49_BLOCKRAM.v stays listed for the
# Verilog it shares, but MEM_43 no longer instantiates it here.
set_global_assignment -name VERILOG_FILE ../../fpga/tang-nano-20k/sdram-bridge/MEM_RAM_49_SDRAM.v
set_global_assignment -name VERILOG_FILE ../../fpga/tang-nano-20k/sdram-bridge/sdram18.v

# --- storage from OSD-mounted images (01-SEP-2026) ---------------------------
# The three controller-facing adapters are the SAME files the Tang and Nexys
# build; only the backend differs: nd_storage_hps speaks hps_io's block
# interface instead of an SD card. Nothing else from SD-FAT/ belongs here -
# no FAT walker, no sector engine, no card init.
set_global_assignment -name VERILOG_FILE rtl/nd_storage_hps.v
set_global_assignment -name VERILOG_FILE rtl/nd_storage_mister_devices.v
set_global_assignment -name VERILOG_FILE ../../SD-FAT/circuit/nd_storage_floppy_adapter.v
set_global_assignment -name VERILOG_FILE ../../SD-FAT/circuit/nd_storage_disc_adapter.v
set_global_assignment -name VERILOG_FILE ../../SD-FAT/circuit/nd_storage_tape_adapter.v

# --- the shared, board-independent terminal core ----------------------------
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/terminal_top.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/terminal_ctrl.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/text_screen.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/char_ram.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/vga_timing.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/font_rom.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/cdc_byte.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/console_uart_rx.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/console_uart_tx.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/byte_fifo.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/ps2_decoder.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/ps2_ascii_table.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/key_vt100.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/term_banner.v
# The banner ROM is GENERATED per build by `make banner` (Makefile) with the
# git hash, date and the board/clock/memory/cache line - the same stamp the
# Nexys build.tcl makes. build/ is ignored by git; the committed
# ../../Terminals/rtl/term_banner_rom.v is the fallback the Makefile copies in
# when the generator cannot run.
set_global_assignment -name VERILOG_FILE build/term_banner_rom.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/term_console_feed.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/term_panel.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/term_panel_rom.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/rate_meter.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/mips_counter.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/ratio_meter.v

# NOTE: ps2_keyboard.v is deliberately NOT here. It is the PS/2 SERIAL front
# end, which the Nexys needs because its onboard microcontroller hands the FPGA
# a raw clock/data pair. On MiSTer, Linux has already done the framing and
# hps_io delivers decoded scancodes, so only ps2_decoder.v is wanted.

# --- top level --------------------------------------------------------------
set_global_assignment -name SDC_FILE nd120.sdc
set_global_assignment -name SYSTEMVERILOG_FILE nd120.sv

