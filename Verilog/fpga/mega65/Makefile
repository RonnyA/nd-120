# ND-120 on MEGA65 (R4/R5/R6) - standard board-folder build API (see ../README.md)
#
# The MEGA65 port is in the planning phase - no Vivado project exists yet.
# Placeholders so every board folder answers to the same commands; they will
# delegate to a build.tcl in the nexys4ddr style (same part family, same
# Vivado flow) once the top/XDC/SDRAM backend land. See docs/00-plan.md.

all load flash:
	@echo "mega65: no build yet - the port is in the planning phase."
	@echo "See docs/00-plan.md (phase plan, R4+ target, M2M framework decision)."
	@exit 1

.PHONY: all load flash
