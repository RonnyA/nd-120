// Tang Nano 20K package pins for the SDRAM test
// Pinout per Sipeed wiki + sipeed/TangNano-20K-example.
// NOTE (Gowin EDA flow): the O_sdram_*/IO_sdram_* ports are "magic" names that
// the Gowin toolchain connects to the on-package SDRAM automatically - they
// must NOT appear here. The OSS flow (yosys/nextpnr/apicula) needs them pinned
// explicitly instead: see sdram_pins_oss.cst (appended by the Makefile).

IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP;

IO_LOC "s1" 88;
IO_PORT "s1" PULL_MODE=NONE;

// BL616 USB serial (shows up as a COM port on the host)
IO_LOC "uart_txp" 69;
IO_PORT "uart_txp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rxp" 70;
IO_PORT "uart_rxp" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 on-board LEDs (active low)
IO_LOC "led[5]" 20;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[0]" 15;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
